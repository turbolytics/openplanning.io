      "name": "Administrative Appeal",
      "description": "Appeal of a decision made by an administrative official, typically the Zoning Administrator. Board reviews whether the administrative decision was correct. Per Chapter 180-105(A)(1) and 180-107.",
      "graph": {
        "nodes": {
          "appeal_filed": {
            "label": "Appeal Filed",
            "is_initial": true,
            "description": "Filed within 30 days of administrative decision. Filed with Zoning Administrator AND with the Board. Must specify grounds of appeal. Filing stays the administrative decision unless stay is specifically denied."
          },
          "record_transmitted": {
            "label": "Record Transmitted",
            "description": "Zoning Administrator transmits all papers constituting the record of the action appealed. Board now has full record."
          },
          "staff_review": {
            "label": "Staff Review",
            "description": "Staff prepares agenda consulting with Chair. Placed on agenda within reasonable time."
          },
          "hearing_scheduled": {
            "label": "Hearing Scheduled",
            "description": "15 day newspaper notice (2 consecutive issues), 14 day 22x28 inch property posting, certified mail to appellant and contiguous owners. Expert reports for all parties due 20 days before hearing."
          },
          "hearing_held": {
            "label": "Hearing Held",
            "description": "Appellant presents, then staff/administrative officials, opposition, other parties, rebuttal, closing. Testimony under oath. Appellant bears burden of proof."
          },
          "decision_pending": {
            "label": "Written Decision Pending",
            "description": "Written resolution required. Must contain findings of fact and legal conclusions on whether administrative decision was correct."
          },
          "affirmed": {
            "label": "Administrative Decision Affirmed"
          },
          "reversed": {
            "label": "Administrative Decision Reversed"
          },
