          "reconsideration": {
            "label": "Reconsideration",
            "description": "Must occur at Board's next meeting only. Grounds: non-conformance with law/Rules, clerical error, or new evidence not discoverable before hearing."
          },
          "appealed_circuit_court": {
            "label": "Appealed to Circuit Court",
            "description": "Carroll County Circuit Court. Town Code does not specify appeal period for BZA decisions."
          }
